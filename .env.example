NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Boarding-pass vision scanner. The model override is optional.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Public production origin used by links in transactional emails.
NEXT_PUBLIC_APP_URL=https://ukc-social.vercel.app
# Mailbox that sends friend-request notifications, over SMTP so it works without
# a domain of our own. For Gmail this is the account address and an App Password
# (not the account password; the account needs 2FA on for App Passwords to exist).
# Leave either blank and notifications are simply skipped.
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to smtp.gmail.com on 465. Port 587 is STARTTLS and is
# handled automatically. Point these elsewhere to move to a real domain later.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional. Defaults to the SMTP_USER mailbox. Gmail rejects a From that is not
# the authenticated account or one of its verified aliases.
FRIEND_REQUEST_EMAIL_FROM=
ADMIN_EMAIL=such4283@gmail.com
# Shared secret checked by app/api/cron/auto-match — set this to a random
# string and configure the same value as the Vercel Cron job's bearer token.
CRON_SECRET=

# Optional: Google Gemini (2.5 Flash) for bespoke group names. Without it, the
# deterministic bank in data/group-names.json is used. See docs/group-naming-logic.md.
GEMINI_API_KEY=
